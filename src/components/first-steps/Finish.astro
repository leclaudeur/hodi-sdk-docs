---
import type { Doc } from '../../lib/docs.ts'
import { firstStepsUrl } from '../../lib/first-steps.ts'
import { t } from '../../lib/i18n.ts'
import { inline } from '../../lib/inline.ts'
import Icon from '../Icon.astro'

// The end, as the app's tour ends: confetti over the dimmed editor and a dialog that sums the four steps up.
interface Props {
  doc: Doc
  home: string
}

const { doc, home } = Astro.props
const finish = doc.entry.data.finish
const lastStep = firstStepsUrl(doc, String(doc.entry.data.steps?.length ?? 1))
---

{finish && (
  <div class="tz-done" data-close={lastStep}>
    <a class="scrim" href={lastStep} tabindex="-1" aria-hidden="true"></a>
    <div class="dlg" role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="tz-done-title">
      <div class="dlg-h">
        <h2 id="tz-done-title">{finish.title}</h2>
        <a class="round" href={lastStep} aria-label={t(doc.lang, 'close')}>
          <Icon name="x" />
        </a>
      </div>
      <div class="dlg-b">
        <p class="dlg-intro">{finish.intro}</p>
        <ol class="v-list recap">
          {finish.recap.map(item => (
            <li class="done">
              <span class="b">
                <Icon name="check" size={12} />
              </span>
              <span class="tx">
                <b>{item.name}</b>
                <span set:html={inline(item.text, doc.lang)} />
              </span>
            </li>
          ))}
        </ol>
        <p class="real">
          <b>{finish.real}</b>
          <span>{finish.realText}</span>
        </p>
        <div class="dlg-a">
          <a class="btn icon" href={doc.url} data-forget>
            <Icon name="rotate-ccw" />
            {t(doc.lang, 'firstStepsAgain')}
          </a>
          <a class="btn primary icon end" href={home} data-forget>
            {t(doc.lang, 'firstStepsGuide')}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
    <div class="confetti" aria-hidden="true"></div>
  </div>
)}
